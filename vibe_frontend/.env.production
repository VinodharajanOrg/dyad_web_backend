# Next.js Production Configuration
NODE_ENV=production

# API Configuration
# Backend API URL - UPDATE THIS to your production backend URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# WebSocket URL for real-time communication
# UPDATE THIS to your production WebSocket URL
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# Security
# Disable telemetry in production
NEXT_TELEMETRY_DISABLED=1

# Optional: Analytics
# Uncomment and set your analytics keys if using PostHog or similar
# NEXT_PUBLIC_POSTHOG_KEY=your-production-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_FEATURE_X=true
