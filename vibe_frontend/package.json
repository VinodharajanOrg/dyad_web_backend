{
  "name": "dyad-web",
  "version": "1.0.0",
  "description": "Free, open-source AI app builder - Web Version",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyad-sh/dyad.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview": "next start",
    "ts": "npx tsc --noEmit",
    "lint": "npx oxlint --fix && next lint",
    "lint:fix": "npx oxlint --fix --fix-suggestions --fix-dangerously",
    "prettier:check": "npx prettier --check .",
    "prettier": "npx prettier --write .",
    "presubmit": "npm run prettier:check && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
