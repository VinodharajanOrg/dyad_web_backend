# Unified Nginx Setup - Git Ignore

# SSL Certificates (keep structure, ignore actual certs)
ssl/*.pem
ssl/*.key
ssl/*.crt

# Logs
logs/nginx/*.log
logs/nginx/*.gz

# Environment files
.env
.env.local
.env.production

# Docker volumes
postgres_data/

# macOS
.DS_Store

# Temporary files
*.swp
*.swo
*~
# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Ignore Jest coverage reports
coverage/

# Ignore Drizzle build metadata (optional)
drizzle/meta/
drizzle/*.sql

# Ignore SonarQube scanner work directory
.scannerwork/

# Ignore SonarQube security fix documentation
SECURITY_FIX_SONAR.md

# Ignore SonarQube configuration and test output files
sonar-project.properties
test_out.txt
test_output.txt
scripts/fast-sonar-scan.ps1

# Environment variables
.env
