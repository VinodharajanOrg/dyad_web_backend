# Keycloak Production Environment Variables
# Copy this file to .env.keycloak and customize for your environment

# PostgreSQL Configuration
POSTGRES_USER=keycloak_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=keycloak_db

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_admin_password

# Keycloak Hostname (your server IP or domain)
KC_HOSTNAME=10.157.147.235

# Logging Level (info, warn, error, debug)
KC_LOG_LEVEL=info
