# Unified Environment Configuration
# Copy this file to .env and fill in your values

# General Configuration
NODE_ENV=production
COMPOSE_PROJECT_NAME=dyad

# Backend Configuration
PORT=3001

# Frontend Configuration  
NEXT_PUBLIC_API_URL=https://localhost/api

# SSL Configuration
# Note: All environment variables are loaded from individual service .env files
# This file is for docker-compose level variables only

# Optional: Let's Encrypt Configuration
# LETSENCRYPT_EMAIL=your-email@example.com
# LETSENCRYPT_DOMAIN=yourdomain.com
