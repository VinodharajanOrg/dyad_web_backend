# Root .env file for docker-compose
# This file contains docker-compose level variables only
# Individual service configurations are in their respective .env files:
#   - dyad_web_backend/.env (backend configuration)
#   - dyad-web/env.local (frontend configuration)

# Compose Configuration
NODE_ENV=production
COMPOSE_PROJECT_NAME=vibe-mastercard-poc

# Port Configuration (used by docker-compose port mapping)
PORT=3001
NEXT_PUBLIC_API_URL=https://localhost/api
